// ============================================================================

/// 成本条目行（CostEntryStore 端口的 PG 持久化；append-only 事实，证据七
/// 公共列 TEXT 口径；(tenant, source_key) 唯一 = 来源单据幂等锚点；来源重
/// 定价追加 delta 条目（deltaOf 指回基准），净额 = Σ 同基准条目）。
model CostEntryRecord {
  id           String    @id @default(uuid(7))
  tenantId     String    @map("tenant_id")
  seq          BigInt    @default(autoincrement()) @db.BigInt
  workOrderId  String    @map("work_order_id")
  category     String
  amountMinor  Int?      @map("amount_minor")
  quantity     Float?
  trade        String?
  sourceType   String    @map("source_type")
  sourceRefId  String    @map("source_ref_id")
  sourceKey    String    @map("source_key")
  deltaOf      String?   @map("delta_of")
  workDate     String?   @map("work_date")
  remark       String?
  occurredAt   DateTime  @db.Timestamptz(6) @map("occurred_at")
  recordedBy   String    @map("recorded_by")
  objectVersion Int      @default(1) @map("object_version")
  auditStatus  String    @map("audit_status")
  provenance   Json?     @map("provenance")
  supersedes   String?   @map("supersedes")
  businessTime DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")

  @@unique([tenantId, sourceKey])
  @@index([tenantId, workOrderId])
  @@index([tenantId, category])
  @@map("cost_entries")
}

/// 口径版本行（CostingModelStore 端口的 PG 持久化；版本化主数据——形态同
/// process_defs：(tenant, code, objectVersion) 与 (tenant, supersedes) 唯一；
/// definition JSONB = 类别映射/时薪表/分摊规则声明段；口径变更不改历史快照）。
model CostingModelRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  code          String
  name          String?
  definition    Json
  status        String    @default("active")
  objectVersion Int       @default(1) @map("object_version")
  supersedes    String?   @map("supersedes")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, code, objectVersion])
  @@unique([tenantId, supersedes])
  @@index([tenantId, code])
  @@map("costing_models")
}

/// 成本快照行（CostSnapshotStore 端口的 PG 持久化；工作令×口径 的重算结果，
/// 可重算快照——supersedes 链，重算幂等 = 值未变不追加新行；totals JSONB =
