// 域事件不建新表（落既有 event_records / outbox_records，见 pg-payroll-stores）。
// ============================================================================

/// 计薪规则版本行（PayrollRuleStore 端口的 PG 持久化；版本化主数据——形态同
/// costing_models：(tenant, rule_id, object_version) 与 (tenant, supersedes) 唯一；
/// rule_id = kebab 业务身份跨版本稳定；scope JSONB = personId/laborKind/projectId
/// 适用面（86 人员时薪 = personId 规则）；量纲 rate_minor=分/小时整数、
/// coefficient 乘数缺省 1）。
model PayrollRuleRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  ruleId        String    @map("rule_id")
  name          String?
  basis         String    @default("hours")
  rateMinor     Int       @map("rate_minor")
  coefficient   Float     @default(1)
  scope         Json
  objectVersion Int       @default(1) @map("object_version")
  supersedes    String?   @map("supersedes")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, ruleId, objectVersion])
  @@unique([tenantId, supersedes])
  @@index([tenantId, ruleId])
  @@map("payroll_rules")
}

/// 核算批次快照行（PayRunStore 端口的 PG 持久化；人×月一版一行，supersedes 链
/// 线性不变量；rule_versions JSONB = 本批次规则版本集（历史按当时版本可复算）；
/// 量纲 total_quantity=小时不取整、total_amount_minor=分整数）。
model PayRunRecord {
  id               String    @id @default(uuid(7))
  tenantId         String    @map("tenant_id")
  personId         String    @map("person_id")
  periodKey        String    @map("period_key")
  periodKind       String    @default("month") @map("period_kind")
  ruleVersions     Json      @map("rule_versions")
  totalQuantity    Float     @map("total_quantity")
  totalAmountMinor Int       @map("total_amount_minor")
  lineCount        Int       @map("line_count")
  computedBy       String    @map("computed_by")
  computedAt       DateTime  @db.Timestamptz(6) @map("computed_at")
  objectVersion    Int       @default(1) @map("object_version")
  supersedes       String?   @map("supersedes")
  auditStatus      String    @map("audit_status")
  provenance       Json?     @map("provenance")
  businessTime     DateTime? @db.Timestamptz(6) @map("business_time")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, periodKey, personId, objectVersion])
  @@unique([tenantId, supersedes])
  @@index([tenantId, periodKey])
  @@index([tenantId, personId])
  @@map("pay_runs")
}

/// 薪酬记录行（EarningsRecordStore 端口的 PG 持久化；append-only 核算产出事实，
/// 证据七公共列 TEXT 口径 + seq 游标；(tenant, source_key) 唯一 = 核算行幂等
/// 锚点；重算逐条重写新行不改原行（costing delta 先例）；source_refs JSONB =
/// 来源工时账目 id 集（下钻 hours LaborEntry）；量纲 quantity=小时、
/// rate_minor=分/小时、amount_minor=分整数 half-up）。
model EarningsRecordRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  seq           BigInt    @default(autoincrement()) @db.BigInt
  personId      String    @map("person_id")
  periodKey     String    @map("period_key")
  ruleId        String    @map("rule_id")
  ruleVersion   Int       @map("rule_version")
  basis         String
  laborKind     String    @map("labor_kind")
  quantity      Float
  rateMinor     Int       @map("rate_minor")
  coefficient   Float
  amountMinor   Int       @map("amount_minor")
  payRunId      String    @map("pay_run_id")
  sourceRefs    Json      @map("source_refs")
  sourceKey     String    @map("source_key")
  occurredAt    DateTime  @db.Timestamptz(6) @map("occurred_at")
  recordedBy    String    @map("recorded_by")
  objectVersion Int       @default(1) @map("object_version")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  supersedes    String?   @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")

  @@unique([tenantId, sourceKey])
  @@index([tenantId, periodKey, personId])
  @@index([tenantId, payRunId])
  @@map("earnings_records")
}

/// 命令幂等记账行（PayrollOperationStore 端口的 PG 持久化；运营表，形态同
/// hours_operations / costing_operations）。
model PayrollOperationRecord {
  id          String   @id @default(uuid(7))
