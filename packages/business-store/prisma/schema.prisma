  @@unique([tenantId, sourceKey])
  @@index([tenantId, workerId, workDate])
  @@index([tenantId, workOrderId])
  @@index([tenantId, sourceReportId])
  @@map("labor_entries")
}

/// 月度归集快照行（LaborLedgerMonthStore 端口的 PG 持久化；可重算快照——
/// 人×月×工种一版一行，supersedes 自引用链；重算幂等 = 值未变不追加新行）。
