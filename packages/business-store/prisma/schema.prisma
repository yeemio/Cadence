// Cadence business-store —— PostgreSQL 存储基座（M1 增量 2-A；3-D 增组织配置三表）
//
// 依据：
//   - architecture/contracts/evidence-columns.v1.md（证据标准公共列）
//   - ADR-0003 #5（append-only 账本：事件表 + Outbox）
//   - ADR-0005（双形态多租户：全表 tenant_id；RLS 在 M4 落地）
//   - ADR-0010（领域内核通用词汇；audit_status 合法值由 M2 领域规格定义，故为 String）
//   - M1 增量 3-D：users / roles / policies——组织配置表，普通 CRUD（非事实表）
//
// 证据公共列复用模式：Prisma 无 mixin——证据列以"约定字段块"在每个事实模型重复，
// 漂移由 tests/schema-conformance.test.ts 机器校验（漏列/改型即红）。
// 新增事实表 = 照抄证据字段块 + 领域键列，业务载荷列等 M2 领域规格产出后再增补。
//
// id 生成策略：PG 无内建 uuidv7——统一在应用侧生成（src/ids/uuidv7.ts，uuid 包 v7），
// @default(uuid(7)) 是 Prisma Client 侧兜底（漏传 id 时仍得时间有序 id）。
//
// append-only 纪律（双层防线，取舍见本包 README）：
//   1. 应用层写门 asAppendOnly()（src/append-only/）——仓储拿不到 update/delete；
//   2. DB 触发器（migrations/ 内手写）拒绝事实表与事件表的 UPDATE/DELETE。
//      Outbox 例外：投递记账必须可 UPDATE（attempts / delivered_at）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 示例业务事实表：工作令记录（ADR-0010 通用词汇）。
/// 证据公共列完整落地；业务载荷列由 M2 领域规格增补（清洁室：不预造字段）。
/// append-only：修正 = 新行 supersedes 指向前任，objectVersion +1。
model WorkOrderRecord {
  id            String  @id @default(uuid(7)) @db.Uuid
  tenantId      String  @map("tenant_id")
  workOrderId   String  @map("work_order_id") @db.Uuid
  objectVersion Int     @default(1) @map("object_version")
  auditStatus   String  @map("audit_status")
  provenance    Json?   @map("provenance")
  supersedes    String? @db.Uuid @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")

  /// 修正链（同租户内自引用：fields 含 tenantId，防跨租户 supersedes）
  predecessor WorkOrderRecord?  @relation("SupersedesChain", fields: [supersedes, tenantId], references: [id, tenantId])
  successors  WorkOrderRecord[] @relation("SupersedesChain")

  @@unique([id, tenantId])
  @@unique([tenantId, supersedes])
  @@index([tenantId, workOrderId])
  @@map("work_order_records")
}

/// append-only 业务事件表：载荷即 business-core BusinessEvent 形状
/// （eventId 为自然主键——幂等：同一事件只允许落一次）。
/// aggregate 三列是 EventAggregateRef 的扁平化（可索引、可按聚合查询）。
/// UPDATE/DELETE 被迁移内触发器拒绝。
model BusinessEventRecord {
  eventId           String    @id @map("event_id")
  tenantId          String    @map("tenant_id")
  eventType         String    @db.VarChar(128) @map("event_type")
  aggregateId       String    @map("aggregate_id")
  aggregateType     String    @map("aggregate_type")
  aggregateRevision Int       @map("aggregate_revision")
  occurredAt        DateTime  @db.Timestamptz(6) @map("occurred_at")
  businessTime      DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime     DateTime? @db.Timestamptz(6) @map("available_time")
  provenance        Json?     @map("provenance")
  payload           Json      @map("payload")

  outboxEntries OutboxRecord[]

  @@index([tenantId, occurredAt])
  @@index([tenantId, aggregateId, aggregateRevision])
  @@map("event_records")
}

/// Outbox 投递记账（OutboxRecord 形状 + tenant_id——ADR-0005 全表纪律）。
/// 唯一不设 append-only 触发器的表：投递器必须能 UPDATE attempts/delivered_at。
model OutboxRecord {
  eventId       String    @id @map("event_id")
  tenantId      String    @map("tenant_id")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  attempts      Int       @default(0) @map("attempts")
  lastAttemptAt DateTime? @db.Timestamptz(6) @map("last_attempt_at")
  nextAttemptAt DateTime? @db.Timestamptz(6) @map("next_attempt_at")
  deliveredAt   DateTime? @db.Timestamptz(6) @map("delivered_at")

  event BusinessEventRecord @relation(fields: [eventId], references: [eventId])

  @@index([deliveredAt, nextAttemptAt])
  @@map("outbox_records")
}

// ---------------------------------------------------------------------------
// 组织/用户/角色管理（M1 增量 3-D）。配置数据非业务事实：普通 CRUD 表，
// 不套证据公共列、不套 append-only/supersedes（取舍见包 README"组织配置表"节）。
// 词汇纪律（ADR-0010）：users / roles / policies / tenant 全部通用词。
// ---------------------------------------------------------------------------

/// 用户元数据（组织管理）。id 文本主键 + uuid(7) 兜底默认：
/// 种子与演示身份可用稳定非 uuid id（如 user-demo-admin，与 dev 身份头
/// 同形）；运行期创建走应用侧 uuidv7 权威生成（同本包 id 策略）。
/// password_hash（M1 收尾波-③）：scrypt 自述格式串，可空——组织端点创建的
/// 用户默认未设口令（不能登录），种子为演示身份设默认口令。
model UserRecord {
  id           String  @id @default(uuid(7))
  tenantId     String  @map("tenant_id")
  username     String
  displayName  String  @map("display_name")
  active       Boolean @default(true)
  passwordHash String? @map("password_hash")

  @@unique([tenantId, username])
  @@map("users")
}

/// 会话行（M1 收尾波-③ 真实认证）。token_digest = sha256(token)——**明文
/// token 不落库**（拖库不可冒用）。轻量运营状态（撤销 = UPDATE revoked_at），
/// 非业务事实：不套证据公共列、不设 append-only 触发器（同 todos 取舍）。
/// refresh_expires_at 是续期窗口上界（首签 +7d，绝对上限不随续期滑动）。
/// user_id 不设外键——同 policies 取舍：端口合同的用户是通用字符串 id，
/// 停用撤销按 (tenant_id, user_id) 索引扫，不做级联。
model SessionRecord {
  id               String    @id @default(uuid(7))
  tenantId         String    @map("tenant_id")
  userId           String    @map("user_id")
  tokenDigest      String    @unique @map("token_digest")
  createdAt        DateTime  @db.Timestamptz(6) @map("created_at")
  expiresAt        DateTime  @db.Timestamptz(6) @map("expires_at")
  refreshExpiresAt DateTime  @db.Timestamptz(6) @map("refresh_expires_at")
  revokedAt        DateTime? @db.Timestamptz(6) @map("revoked_at")

  @@index([tenantId, userId])
  @@map("sessions")
}

/// 登录失败计数/锁定行（M2 安全前置批 SP-1）。轻量运营状态——同 sessions
/// 取舍：不套证据公共列、不设 append-only 触发器。计数键 = (tenant_id,
/// username)（@@unique 兼作 ON CONFLICT 原子自增目标与 tenant_id 前导索引）；
/// 窗口/锁定语义在应用端口（application/src/auth/login-attempt-stores.ts），
/// PG 侧计数自增走单语句原子 upsert（pg-org-stores.ts PgLoginAttemptStore）。
/// 成功登录清零 = 删行；username 不设外键——键含"不存在的用户"（防候选
/// 用户名爆破），与 policies 的通用字符串 id 取舍同向。
model LoginAttemptRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  username      String
  failureCount  Int       @map("failure_count")
  lastFailureAt DateTime  @db.Timestamptz(6) @map("last_failure_at")
  lockedUntil   DateTime? @db.Timestamptz(6) @map("locked_until")
  updatedAt     DateTime  @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, username])
  @@map("login_attempts")
}

/// 角色元数据（RBAC 角色名 = PolicyRule.role 段形状，application 侧 roleName() 校验）。
/// 角色-权限与用户-角色绑定不在本表——存 policies（PolicyStore 事实源）。
model RoleRecord {
  id          String @id @default(uuid(7))
  tenantId    String @map("tenant_id")
  name        String
  displayName String @map("display_name")

  @@unique([tenantId, name])
  @@map("roles")
}

/// casbin 策略行（PolicyStore 端口的 PG 持久化，M1 增量 3-D）。
/// rule_key 自然主键 = 规则规范键（与 application 内存实现的 Map 键同形状，
/// 见 src/org/policy-mapping.ts）：append 幂等靠 PK 冲突跳过（skipDuplicates），
/// remove 按键精确删除。不设 users/roles 外键——端口合同的用户/角色是通用
/// 字符串 id（dev 策略钩子与 mock 身份不受组织表外键约束），组织管理端点
/// 在用例层自行校验存在性（404）。
model PolicyRecord {
  ruleKey   String  @id @map("rule_key")
  tenantId  String  @map("tenant_id")
  kind      String
  userId    String? @map("user_id")
  role      String?
  resource  String?
  action    String?

  @@index([tenantId])
  @@map("policies")
}

// ---------------------------------------------------------------------------
// 基础数据（M1 增量 4-I）。与组织配置表同取舍：主数据是**配置数据非业务
// 事实**——普通 CRUD 表，不套证据公共列、不套 append-only/supersedes；
// 词汇纪律（ADR-0010 判定三问）：items / resources / category / spec 全
// 跨行业通用词，行业语义只进数据行不进代码。
// ---------------------------------------------------------------------------

/// 物品主数据（通用"物"概念：原料/半成品/成品/辅料……分类由 category 自由描述）。
/// 租户内 code 唯一；无 delete——停用走 active=false（M2 事务表将引用，避免悬挂）。
model ItemRecord {
  id        String   @id @default(uuid(7))
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  spec      String?
  unit      String?
  category  String?
  active    Boolean  @default(true)
  /// 初始价格（含税单价，分；可空 = 未维护——RREQ-MD-020，fix-wave-6 6b-1 S9。
  /// 成本取价兜底联动归 costing 对账口径，本批不做）。Int 分口径与
  /// listing unit_price_minor / 全库 minor 列一致。
  initialPriceMinor Int?     @map("initial_price_minor")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, code])
  @@map("items")
}

/// 资源主数据（通用"产能资源"概念：设备/工位/人员组……类型由 type 自由描述）。
model ResourceRecord {
  id        String   @id @default(uuid(7))
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  type      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, code])
  @@map("resources")
}

// ---------------------------------------------------------------------------
// 工作台待办（M1 增量 4-I）。轻量运营状态（open→done 单向迁移），非业务
// 事实——同上不套证据列/append-only。数据级过滤合同：一切读操作按
// (tenant_id, assignee_id) 双键收口（application 端口合同）。
// ---------------------------------------------------------------------------

/// 待办行（TodoItem 端口的 PG 持久化；source=来源模块码，refType/refId=可选业务指向）。
model TodoRecord {
  id         String    @id @default(uuid(7))
  tenantId   String    @map("tenant_id")
  assigneeId String    @map("assignee_id")
  title      String
  source     String
  refType    String?   @map("ref_type")
  refId      String?   @map("ref_id")
  status     String    @default("open")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  dueAt      DateTime? @db.Timestamptz(6) @map("due_at")

  @@index([tenantId, assigneeId, status])
  @@map("todos")
}

// ---------------------------------------------------------------------------
// 审批（M1 收尾波-①；application/approval 端口 + engine-flow 记录/事件端口的
// PG 实现）。三表分工：
//   approval_cases   案件行 = 事件账本的**投影**（state/object_version 随迁移
//                    UPDATE）——运营状态非事实表，同 todos 取舍：不套证据列、
//                    不设 append-only 触发器；
//   approval_records 决策记录账本（append-only，触发器拒 UPDATE/DELETE）；
//   approval_events  迁移事件账本（append-only；seq = 大单调游标，映射
//                    engine ApprovalEventCursor；(aggregate_id, aggregate_revision)
//                    唯一 = DB 级乐观锁：并发对同一版本提交两个迁移，必有一个被拒）。
// engine 端口不带租户参数——租户经案件行解析（聚合锚定 = 案件，见适配层注释）。
// 词汇纪律（ADR-0010）：case/approval/decision/subject 全通用词。
// ---------------------------------------------------------------------------

/// 审批案件行（ApprovalCaseStore 端口的 PG 持久化）。
model ApprovalCaseRecord {
  id            String   @id @default(uuid(7))
  tenantId      String   @map("tenant_id")
  flowConfigId  String   @map("flow_config_id")
  state         String
  objectVersion Int      @default(1) @map("object_version")
  subjectType   String   @map("subject_type")
  subjectId     String   @map("subject_id")
  submitterId   String   @map("submitter_id")
  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, state])
  @@index([tenantId, createdAt])
  @@map("approval_cases")
}

/// 审批决策记录行（engine-flow ApprovalRecordStore 端口的 PG 持久化；append-only）。
model ApprovalDecisionRecord {
  id            String   @id @default(uuid(7))
  tenantId      String   @map("tenant_id")
  aggregateId   String   @map("aggregate_id")
  aggregateType String   @map("aggregate_type")
  reviewerId    String   @map("reviewer_id")
  decision      String
  reason        String
  evidence      Json
  objectVersion Int      @map("object_version")
  decidedAt     DateTime @db.Timestamptz(6) @map("decided_at")

  @@index([tenantId, aggregateId])
  @@map("approval_records")
}

/// 审批迁移事件行（engine-flow ApprovalEventStore 端口的 PG 持久化；append-only）。
model ApprovalEventRecord {
  seq               BigInt   @id @default(autoincrement()) @db.BigInt
  eventId           String   @unique @map("event_id")
  tenantId          String   @map("tenant_id")
  eventType         String   @db.VarChar(128) @map("event_type")
  aggregateId       String   @map("aggregate_id")
  aggregateType     String   @map("aggregate_type")
  aggregateRevision Int      @map("aggregate_revision")
  occurredAt        DateTime @db.Timestamptz(6) @map("occurred_at")
  payload           Json     @map("payload")

  @@unique([aggregateId, aggregateRevision])
  @@index([tenantId, aggregateId, seq])
  @@map("approval_events")
}

// ---------------------------------------------------------------------------
// baseline 技术准备（M2-W2 P1 子集：工序/设备/外协计价规则/物料校验运行）。
// 四对象是**版本化主数据**（合同 01-baseline.md §2：draft→active→superseded，
// 新版本 supersedes 旧版）：完整证据公共列 + supersedes 自引用修正链 +
// append-only 触发器（对齐 work_order_records 体例）——版本不可变、修正只加行。
// (tenant_id, code, object_version) 唯一 = 并发同版本写入竞态防线；
// (tenant_id, supersedes) 唯一 = 链线性（一行至多被取代一次）。
// baseline_command_operations 是命令幂等账本（smes.command.v1 不变量 3）：
// 运营表，同 outbox 一类不套证据列/触发器。
// ---------------------------------------------------------------------------

/// 工序库版本行（ProcessDefRow 端口的 PG 持久化；append-only）。
model ProcessDefRecord {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id")
  code          String
  name          String
  category      String?
  description   String?
  /// 写入态 draft/active（superseded 为推导态，不落库——见 application 侧机制注释）
  status        String    @default("active")
  objectVersion Int       @default(1) @map("object_version")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  supersedes    String?   @db.Uuid @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  predecessor ProcessDefRecord?  @relation("SupersedesChain", fields: [supersedes, tenantId], references: [id, tenantId])
  successors  ProcessDefRecord[] @relation("SupersedesChain")

  @@unique([id, tenantId])
  @@unique([tenantId, supersedes])
  @@unique([tenantId, code, objectVersion])
  @@index([tenantId, code])
  @@map("process_defs")
}

/// 设备台账版本行（EquipmentRow 端口的 PG 持久化；append-only）。
model EquipmentRecord {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id")
  code          String
  name          String
  type          String?
  location      String?
  status        String    @default("active")
  objectVersion Int       @default(1) @map("object_version")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  supersedes    String?   @db.Uuid @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  predecessor EquipmentRecord?  @relation("SupersedesChain", fields: [supersedes, tenantId], references: [id, tenantId])
  successors  EquipmentRecord[] @relation("SupersedesChain")

  @@unique([id, tenantId])
  @@unique([tenantId, supersedes])
  @@unique([tenantId, code, objectVersion])
  @@index([tenantId, code])
  @@map("equipment_records")
}

/// 外协计价规则版本行（OutsourcingPriceRuleRow 端口的 PG 持久化；append-only；
/// 单价分 + 利润率万分比整数——取价整数精确，见 application/outsourcing-price.ts）。
model OutsourcingPriceRuleRecord {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id")
  code            String
  name            String?
  /// 计价工序业务码（引用 process_defs.code；跨模块引用走业务码不落外键）
  processCode     String    @map("process_code")
  unitPriceMinor  Int       @map("unit_price_minor")
  marginPermyriad Int       @map("margin_permyriad")
  status          String    @default("active")
  objectVersion   Int       @default(1) @map("object_version")
  auditStatus     String    @map("audit_status")
  provenance      Json?     @map("provenance")
  supersedes      String?   @db.Uuid @map("supersedes")
  businessTime    DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime   DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt       DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  predecessor OutsourcingPriceRuleRecord?  @relation("SupersedesChain", fields: [supersedes, tenantId], references: [id, tenantId])
  successors  OutsourcingPriceRuleRecord[] @relation("SupersedesChain")

  @@unique([id, tenantId])
  @@unique([tenantId, supersedes])
  @@unique([tenantId, code, objectVersion])
  @@index([tenantId, processCode])
  @@map("outsourcing_price_rules")
}

/// 物料校验运行行（MaterialValidationRunRow 端口的 PG 持久化；执行事实：
/// 单行落账无修正链，supersedes 恒 null——证据公共列完整性保留；append-only）。
/// summary/lines 为 JSONB 载荷（判定汇总与逐行判定，形状见 application 侧）。
model MaterialValidationRunRecord {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id")
  issuedBy      String    @map("issued_by")
  summary       Json      @map("summary")
  lines         Json
  objectVersion Int       @default(1) @map("object_version")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  supersedes    String?   @db.Uuid @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@map("material_validation_runs")
}

/// 命令幂等账本（smes.command.v1 不变量 3：operationId 已落账拒绝重复执行）。
/// 运营表非业务事实：不套证据公共列、不设 append-only 触发器（同 outbox 取舍）。
model BaselineOperationRecord {
  id          String   @id @default(uuid(7))
  tenantId    String   @map("tenant_id")
  operationId String   @map("operation_id")
  commandKind String   @map("command_kind")
  claimedAt   DateTime @default(now()) @db.Timestamptz(6) @map("claimed_at")

  @@unique([tenantId, operationId])
  @@map("baseline_command_operations")
}

// ---------------------------------------------------------------------------
// baseline P2/P3 件（M2-W7）：工艺路线（routings，版本化主数据——业务键 code =
// 图号，steps 为 JSONB 工序序列）+ 额定工时（standard_times，版本化主数据——
// 工时量纲秒整数）+ 故障单（fault_reports，投影行——state 随 ASSIGN/RESOLVE/
// REJECT 迁移 UPDATE，体例同 inspections，不套证据公共列）+ 故障状态机事件账本
// （fault_events，append-only——engine-flow ApprovalEventStore 的 PG 持久化，
// (aggregate_id, aggregate_revision) 唯一 = DB 级乐观锁，同 inspection_events）。
// 故障命令幂等复用 baseline_command_operations（同模块同一账本，不另建表）。
// ---------------------------------------------------------------------------

/// 工艺路线版本行（RoutingRow 端口的 PG 持久化；append-only；code = 图号）。
model RoutingRecord {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id")
  code          String
  name          String?
  /// 工序序列（[{seq, processCode, remark}]；非空、seq 严格递增——载荷层守门）
  steps         Json
  status        String    @default("active")
  objectVersion Int       @default(1) @map("object_version")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  supersedes    String?   @db.Uuid @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  predecessor RoutingRecord?  @relation("SupersedesChain", fields: [supersedes, tenantId], references: [id, tenantId])
  successors  RoutingRecord[] @relation("SupersedesChain")

  @@unique([id, tenantId])
  @@unique([tenantId, supersedes])
  @@unique([tenantId, code, objectVersion])
  @@index([tenantId, code])
  @@map("routings")
}

/// 额定工时版本行（StandardTimeRow 端口的 PG 持久化；append-only；秒整数精确）。
model StandardTimeRecord {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id")
  code               String
  /// 对标维度：process=按工序 / product=按产品（图号）
  scope              String
  /// 对标目标业务码（工序码或产品图号；业务码引用不落外键）
  targetCode         String    @map("target_code")
  /// 每件标准工时（秒）
  standardSeconds    Int       @map("standard_seconds")
  /// 每批/每任务预备工时额度（秒）
  preparationSeconds Int       @map("preparation_seconds")
  status             String    @default("active")
  objectVersion      Int       @default(1) @map("object_version")
  auditStatus        String    @map("audit_status")
  provenance         Json?     @map("provenance")
  supersedes         String?   @db.Uuid @map("supersedes")
  businessTime       DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime      DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt          DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  predecessor StandardTimeRecord?  @relation("SupersedesChain", fields: [supersedes, tenantId], references: [id, tenantId])
  successors  StandardTimeRecord[] @relation("SupersedesChain")

  @@unique([id, tenantId])
  @@unique([tenantId, supersedes])
  @@unique([tenantId, code, objectVersion])
  @@index([tenantId, scope, targetCode])
  @@map("standard_times")
}

/// 故障单投影行（FaultReport 端口的 PG 持久化；id = fr-<uuidv7> TEXT——应用侧
/// 生成；state 随迁移 UPDATE，advance 走 object_version 条件更新，体例同
/// inspections：不套证据公共列、不设 append-only 触发器）。
model FaultReportRecord {
  id               String    @id
  tenantId         String    @map("tenant_id")
  flowConfigId     String    @map("flow_config_id")
  state            String
  objectVersion    Int       @default(1) @map("object_version")
  /// 故障设备业务码（引用 equipment_records.code；业务码挂接不落外键）
  equipmentCode    String    @map("equipment_code")
  description      String
  reportedBy       String    @map("reported_by")
  assignee         String?
  assignedAt       DateTime? @db.Timestamptz(6) @map("assigned_at")
  resolutionRemark String?   @map("resolution_remark")
  resolvedBy       String?   @map("resolved_by")
  resolvedAt       DateTime? @db.Timestamptz(6) @map("resolved_at")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, state])
  @@index([tenantId, createdAt])
  @@map("fault_reports")
}

/// 故障状态机事件账本（engine-flow ApprovalEventStore 的 PG 持久化；append-only；
/// (aggregate_id, aggregate_revision) 唯一 = DB 级乐观锁，同 inspection_events）。
model FaultEventRecord {
  seq               BigInt   @id @default(autoincrement()) @db.BigInt
  eventId           String   @unique @map("event_id")
  tenantId          String   @map("tenant_id")
  eventType         String   @db.VarChar(128) @map("event_type")
  aggregateId       String   @map("aggregate_id")
  aggregateType     String   @map("aggregate_type")
  aggregateRevision Int      @map("aggregate_revision")
  occurredAt        DateTime @db.Timestamptz(6) @map("occurred_at")
  payload           Json     @map("payload")

  @@unique([aggregateId, aggregateRevision])
  @@index([tenantId, aggregateId, seq])
  @@map("fault_events")
}

// ---------------------------------------------------------------------------
// workorder 工作令（M2-W1）。六表分工与 DDL 一一对应（头注见
// migrations/20261025160000_workorder_module/migration.sql）：
//   work_orders / parts_requests   投影行（运营状态，state 随迁移 UPDATE，advance
//                                  走 object_version 条件更新）——同 approval_cases
//                                  取舍：不套证据公共列、不设 append-only 触发器；
//   workorder_events               状态机事件账本（append-only；work-order 与
//                                  parts-request 两类聚合共用，aggregate_type 区分；
//                                  (aggregate_id, aggregate_revision) 唯一 = DB 级
//                                  乐观锁——同 approval_events）；
//   work_order_attachments / kit_checks  业务事实（append-only 不可变，证据七公共
//                                  列齐备）。注意 id/supersedes 为 **TEXT 非 uuid 列**：
//                                  本模块 id 是带前缀的 uuidv7（wo-/att-/kc-/pr-/evt-，
//                                  人读可辨聚合类型），非合法 uuid 字面量——证据字段块
//                                  在 TEXT 口径落地（与迁移 DDL 一致；conformance 测试
//                                  的 workorder 段按此口径断言，不入 @db.Uuid 榜单）；
//   workorder_operations           命令幂等记账（PK = operation_key = 租户+operationId，
//                                  应用侧拼键；运营表，同 outbox 取舍豁免触发器）。
// 域事件（BusinessEvent 形状 + Outbox）不建新表：映射既有 event_records /
// outbox_records（M1 已建——PG 适配见 src/workorder/pg-workorder-stores.ts）。
// ---------------------------------------------------------------------------

/// 工作令投影行（WorkOrderStore 端口的 PG 持久化）。
model WorkOrderProjectionRecord {
  id                 String    @id @default(uuid(7))
  tenantId           String    @map("tenant_id")
  flowConfigId       String    @map("flow_config_id")
  state              String
  objectVersion      Int       @default(1) @map("object_version")
  customerRef        String?   @map("customer_ref")
  projectName        String    @map("project_name")
  salesRep           String?   @map("sales_rep")
  manager            String?   @map("manager")
  plannedDeliveryAt  DateTime? @db.Timestamptz(6) @map("planned_delivery_at")
  packagingArrivalAt DateTime? @db.Timestamptz(6) @map("packaging_arrival_at")
  createdAt          DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, state])
  @@index([tenantId, createdAt])
  @@index([tenantId, manager])
  @@map("work_orders")
}

/// 配件申请投影行（PartsRequestStore 端口的 PG 持久化）。
model PartsRequestRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  workOrderId   String    @map("work_order_id")
  flowConfigId  String    @map("flow_config_id")
  state         String
  objectVersion Int       @default(2) @map("object_version")
  itemId        String    @map("item_id")
  quantity      Float
  requester     String
  remark        String?
  shipmentRef   String?   @map("shipment_ref")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, state])
  @@index([tenantId, workOrderId])
  @@map("parts_requests")
}

/// 工作令迁移事件行（engine-flow ApprovalEventStore 端口的 PG 持久化；append-only；
/// 两类聚合共用本表，aggregate_type 区分——形态同 approval_events）。
model WorkorderEventRecord {
  seq               BigInt   @id @default(autoincrement()) @db.BigInt
  eventId           String   @unique @map("event_id")
  tenantId          String   @map("tenant_id")
  eventType         String   @db.VarChar(128) @map("event_type")
  aggregateId       String   @map("aggregate_id")
  aggregateType     String   @map("aggregate_type")
  aggregateRevision Int      @map("aggregate_revision")
  occurredAt        DateTime @db.Timestamptz(6) @map("occurred_at")
  payload           Json     @map("payload")

  @@unique([aggregateId, aggregateRevision])
  @@index([tenantId, aggregateId, seq])
  @@map("workorder_events")
}

/// 附件事实行（WorkOrderAttachmentStore 端口的 PG 持久化；append-only 不可变，
/// 单行落账无修正链，supersedes 恒 null；id 为带前缀 uuidv7 的 TEXT，见节注）。
model WorkOrderAttachmentRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  workOrderId   String    @map("work_order_id")
  name          String
  kind          String
  ref           String
  attachedBy    String    @map("attached_by")
  attachedAt    DateTime  @db.Timestamptz(6) @map("attached_at")
  objectVersion Int       @default(1) @map("object_version")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  supersedes    String?   @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")

  @@index([tenantId, workOrderId])
  @@map("work_order_attachments")
}

/// 齐套检查快照行（KitCheckStore 端口的 PG 持久化；不可变，每次刷新一条）。
/// seq = 刷新序游标（bigserial）：latest 口径 = (refreshed_at DESC, seq DESC)——
/// 同毫秒并列时毫秒时钟与 uuidv7 随机位都不可靠，插入序是唯一确定决胜。
model KitCheckRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  workOrderId   String    @map("work_order_id")
  seq           BigInt    @default(autoincrement()) @db.BigInt
  kinds         Json
  gapLines      Json      @map("gap_lines")
  complete      Boolean
  refreshedBy   String    @map("refreshed_by")
  refreshedAt   DateTime  @db.Timestamptz(6) @map("refreshed_at")
  objectVersion Int       @default(1) @map("object_version")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  supersedes    String?   @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")

  @@index([tenantId, workOrderId, refreshedAt(sort: Desc), seq(sort: Desc)])
  @@map("kit_checks")
}

/// 命令幂等记账行（WorkOrderOperationStore 端口的 PG 持久化）。
/// operation_key 自然主键 = `${tenant_id}|${operation_id}`（应用侧拼键，租户内
/// operationId 唯一的 PK 级防线）；运营表：不套证据公共列、不设触发器。
model WorkorderOperationRecord {
  operationKey  String   @id @map("operation_key")
  tenantId      String   @map("tenant_id")
  operationId   String   @map("operation_id")
  command       String
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  occurredAt    DateTime @db.Timestamptz(6) @map("occurred_at")

  @@index([tenantId])
  @@map("workorder_operations")
}

// ---------------------------------------------------------------------------
// inspection 四类质检（M2-W4，06-inspection.md v1.0）。四表分工（体例照抄
// workorder 节，DDL 见 migrations/20261025190000_inspection_module）：
//   inspections / nonconformities  投影行（运营状态，state 随判定/处置/闭环迁移
//                                  UPDATE，advance 走 object_version 条件更新）
//                                  ——同 approval_cases 取舍：不套证据公共列、
//                                  不设 append-only 触发器；
//   inspection_events              状态机事件账本（append-only；inspection-order
//                                  与 nonconform 两类聚合共用，aggregate_type 区分；
//                                  (aggregate_id, aggregate_revision) 唯一 = DB 级
//                                  乐观锁——同 approval_events / workorder_events；
//                                  判定迁移的决策记录随 payload 留痕=检验记录事实）；
//   inspection_operations          命令幂等记账（PK = operation_key = 租户+
//                                  operationId，应用侧拼键；运营表，同 outbox
//                                  取舍豁免触发器）。
// 域事件（BusinessEvent 形状 + Outbox）不建新表：复用既有 event_records /
// outbox_records（M1 已建——PG 适配见 src/inspection/pg-inspection-stores.ts）。
// id 为带前缀 uuidv7 的 TEXT（insp-/nc-，人读可辨聚合类型——同 workorder 节注，
// 不入 @db.Uuid 榜单）；(tenant_id, source_type, source_ref_id) 唯一 = 来源幂等
// 的 DB 级防线（Postgres 唯一索引对 NULL 不去重：手工建单多行合法）。
// ---------------------------------------------------------------------------

/// 质检单投影行（InspectionOrderStore 端口的 PG 持久化）。
model InspectionOrderRecord {
  id                String    @id @default(uuid(7))
  tenantId          String    @map("tenant_id")
  flowConfigId      String    @map("flow_config_id")
  state             String
  objectVersion     Int       @default(1) @map("object_version")
  /// 四类：self_outsourced / nonstandard_purchase / standard_purchase / equipment_purchase。
  kind              String
  sourceType        String?   @map("source_type")
  sourceRefId       String?   @map("source_ref_id")
  itemId            String?   @map("item_id")
  drawingNo         String?   @map("drawing_no")
  quantity          Float
  passedQty         Float?    @map("passed_qty")
  failedQty         Float?    @map("failed_qty")
  judgeRemark       String?   @map("judge_remark")
  judgedBy          String?   @map("judged_by")
  judgedAt          DateTime? @db.Timestamptz(6) @map("judged_at")
  /// 闭环时限（failed 判定时定；超时点名锚点）。
  closeDueAt        DateTime? @db.Timestamptz(6) @map("close_due_at")
  overdueNotifiedAt DateTime? @db.Timestamptz(6) @map("overdue_notified_at")
  createdAt         DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, sourceType, sourceRefId])
  @@index([tenantId, kind, state])
  @@index([tenantId, state])
  @@index([tenantId, createdAt])
  @@map("inspections")
}

/// 不合格处置投影行（NonconformStore 端口的 PG 持久化）。
model NonconformRecord {
  id             String    @id @default(uuid(7))
  tenantId       String    @map("tenant_id")
  inspectionId   String    @map("inspection_id")
  flowConfigId   String    @map("flow_config_id")
  state          String
  objectVersion  Int       @default(1) @map("object_version")
  itemId         String?   @map("item_id")
  quantity       Float
  /// 不合格原因（dispose 时必填留痕）。
  reason         String?
  /// 处置枚举：rework / concession / scrap（默认配置层，ADR-0010）。
  disposal       String?
  disposeRemark  String?   @map("dispose_remark")
  disposedBy     String?   @map("disposed_by")
  disposedAt     DateTime? @db.Timestamptz(6) @map("disposed_at")
  closeRemark    String?   @map("close_remark")
  closedBy       String?   @map("closed_by")
  closedAt       DateTime? @db.Timestamptz(6) @map("closed_at")
  createdAt      DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, state])
  @@index([tenantId, inspectionId])
  @@map("nonconformities")
}

/// 质检迁移事件行（engine-flow ApprovalEventStore 端口的 PG 持久化；append-only；
/// 两类聚合共用本表，aggregate_type 区分——形态同 workorder_events）。
model InspectionEventRecord {
  seq               BigInt   @id @default(autoincrement()) @db.BigInt
  eventId           String   @unique @map("event_id")
  tenantId          String   @map("tenant_id")
  eventType         String   @db.VarChar(128) @map("event_type")
  aggregateId       String   @map("aggregate_id")
  aggregateType     String   @map("aggregate_type")
  aggregateRevision Int      @map("aggregate_revision")
  occurredAt        DateTime @db.Timestamptz(6) @map("occurred_at")
  payload           Json     @map("payload")

  @@unique([aggregateId, aggregateRevision])
  @@index([tenantId, aggregateId, seq])
  @@map("inspection_events")
}

/// 命令幂等记账行（InspectionOperationStore 端口的 PG 持久化；运营表不套证据
/// 公共列、不设触发器）。
model InspectionOperationRecord {
  operationKey  String   @id @map("operation_key")
  tenantId      String   @map("tenant_id")
  operationId   String   @map("operation_id")
  command       String
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  occurredAt    DateTime @db.Timestamptz(6) @map("occurred_at")

  @@index([tenantId])
  @@map("inspection_operations")
}

// ---------------------------------------------------------------------------
// listing 清单与采购（M2-W3）。八表分工与 workorder 六表同一取舍（头注见
// migrations/20261025200000_listing_module/migration.sql）：
//   listing_sheets / listing_lines / purchase_requests / purchase_orders /
//   purchase_returns   投影行（运营状态，行级 object_version 乐观更新）——
//                      不套证据公共列、不设 append-only 触发器；清单行为版本化
//                      数据（校验状态字段 + object_version，非状态机）；
//   gap_checks         缺口核查不可变快照（append-only，证据七公共列齐备；
//                      id 为带前缀 uuidv7 的 TEXT，同 workorder 事实表口径）；
//   listing_events     状态机事件账本（append-only；purchase-request /
//                      purchase-order / purchase-return 三类聚合共用，
//                      aggregate_type 区分；(aggregate_id, aggregate_revision)
//                      唯一 = DB 级乐观锁）；
//   listing_operations 命令幂等记账（PK = operation_key = 租户|operationId，
//                      运营表豁免触发器）。
// 域事件（BusinessEvent 形状 + Outbox）不建新表：映射既有 event_records /
// outbox_records（PG 适配见 src/listing/pg-listing-stores.ts）。
// ---------------------------------------------------------------------------

/// 清单单据头投影行（ListingSheetStore 端口的 PG 持久化；(tenant, work_order_id, kind) 唯一）。
model ListingSheetRecord {
  id          String   @id @default(uuid(7))
  tenantId    String   @map("tenant_id")
  workOrderId String   @map("work_order_id")
  kind        String
  name        String
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, workOrderId, kind])
  @@index([tenantId, workOrderId])
  @@map("listing_sheets")
}

/// 清单行投影行（ListingLineStore 端口的 PG 持久化；行级乐观版本 + 校验状态字段）。
model ListingLineRecord {
  id                String    @id @default(uuid(7))
  tenantId          String    @map("tenant_id")
  sheetId           String    @map("sheet_id")
  equipmentRef String? @map("equipment_ref")
  origin String @default("production")
  workOrderId       String    @map("work_order_id")
  kind              String
  lineNo            Int       @map("line_no")
  drawingNo         String?   @map("drawing_no")
  code              String?
  name              String?
  spec              String?
  itemId            String?   @map("item_id")
  requiredQty       Float     @map("required_qty")
  neededBy          DateTime? @db.Timestamptz(6) @map("needed_by")
  validationStatus  String    @map("validation_status")
  candidateItemId   String?   @map("candidate_item_id")
  candidateItemCode String?   @map("candidate_item_code")
  similarity        Float     @default(0)
  basis             String?
  source            String
  objectVersion     Int       @default(1) @map("object_version")
  createdAt         DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, sheetId, lineNo])
  @@index([tenantId, workOrderId])
  @@index([tenantId, sheetId])
  @@map("listing_lines")
}

/// 缺口核查快照行（GapCheckStore 端口的 PG 持久化；不可变，每次核查一条。
/// seq = 核查序游标（bigserial）：latest 口径 = (checked_at DESC, seq DESC)——同毫秒
/// 并列由插入序决胜，同 kit_checks 取舍）。
model GapCheckRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  workOrderId   String    @map("work_order_id")
  seq           BigInt    @default(autoincrement()) @db.BigInt
  kinds         Json
  gapLines      Json      @map("gap_lines")
  complete      Boolean
  checkedBy     String    @map("checked_by")
  checkedAt     DateTime  @db.Timestamptz(6) @map("checked_at")
  objectVersion Int       @default(1) @map("object_version")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  supersedes    String?   @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")

  @@index([tenantId, workOrderId, checkedAt(sort: Desc), seq(sort: Desc)])
  @@map("gap_checks")
}

/// 采购申请投影行（PurchaseRequestStore 端口的 PG 持久化；draft→approved→converted）。
/// 来源锚点（source_type=gap 时 source_gap_check_id / source_listing_line_id 非空）。
model PurchaseRequestRecord {
  id                  String   @id @default(uuid(7))
  tenantId            String   @map("tenant_id")
  workOrderId         String?  @map("work_order_id")
  kind                String
  flowConfigId        String   @map("flow_config_id")
  state               String
  objectVersion       Int      @default(1) @map("object_version")
  itemId              String   @map("item_id")
  quantity            Float
  requester           String
  remark              String?
  sourceType          String   @map("source_type")
  sourceGapCheckId    String?  @map("source_gap_check_id")
  sourceListingLineId String?  @map("source_listing_line_id")
  purchaseOrderId     String?  @map("purchase_order_id")
  createdAt           DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, state])
  @@index([tenantId, workOrderId])
  @@index([tenantId, purchaseOrderId])
  @@map("purchase_requests")
}

/// 采购订单投影行（PurchaseOrderStore 端口的 PG 持久化；五态机，
/// lines / request_ids 为 JSONB 载荷，形状见 application listing-stores）。
model PurchaseOrderRecord {
  id            String   @id @default(uuid(7))
