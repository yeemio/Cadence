  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")

  @@unique([tenantId, sourceKey])
  @@index([tenantId, workOrderId])
  @@index([tenantId, block])
  @@map("cost_project_entries")
}

/// 项目成本六块快照行（CostProjectSnapshotStore 端口的 PG 持久化；工作令×口径
/// 的六块重算结果，可重算快照——supersedes 链，重算幂等 = 值未变不追加新行；
/// totals JSONB = 六块合计 + 块明细（材料四类两段/外协供应商行/人工三行/
/// 售后/设备两段）。legacy 七张结果表的 Cadence 合一落点（口径差异登记）。
model CostProjectSnapshotRecord {
  id            String    @id @default(uuid(7))
