/// 维保任务投影行（MaintenanceTaskStore 端口的 PG 持久化；状态机投影——形态同
/// fault_reports / inspections：state + object_version 随迁移条件更新（非事实表
/// 不套证据公共列）；flow_config_id = engine-flow 配置换代防线；(tenant,
/// source_key) 唯一 = plan-due 任务到期锚点 due:<planId>:<occurrenceKey>
/// （due-scan 幂等去重 DB 防线；manual/fault 任务 source_key 空，PG 默认
/// NULLS DISTINCT 不参与唯一约束）；G2：建单先落 scheduled@v1 投影）。
model MaintenanceTaskRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  flowConfigId  String    @map("flow_config_id")
  source        String
  kind          String
  resourceRef   String    @map("resource_ref")
  faultRef      String?   @map("fault_ref")
  planId        String?   @map("plan_id")
  planVersion   Int?      @map("plan_version")
  dueKey        String?   @map("due_key")
  dueAt         DateTime? @db.Timestamptz(6) @map("due_at")
  assignee      String?
  state         String
  objectVersion Int       @default(1) @map("object_version")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  startedAt     DateTime? @db.Timestamptz(6) @map("started_at")
  completedAt   DateTime? @db.Timestamptz(6) @map("completed_at")
  cancelledAt   DateTime? @db.Timestamptz(6) @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason")
  sourceKey     String?   @map("source_key")

  @@unique([tenantId, sourceKey])
  @@index([tenantId, state])
  @@index([tenantId, resourceRef])
  @@index([tenantId, assignee])
  @@index([tenantId, planId])
  @@map("maintenance_tasks")
}

/// 三态记录行（MaintenanceActivityStore 端口的 PG 持久化；append-only 执行留痕
/// 事实，kind 判别三态 checkpoint/upkeep/repair（草案形状保持）：checkpoint 落
/// checkpoint_id+result；upkeep 落 actions_done JSONB；repair 落 fault_ref+
/// restored；证据七公共列 TEXT 口径 + seq 游标；plan_version 快照 = 记录时点
/// 计划当前版本（溯源旧版可解释）；修正走冲销/补录不改原行（触发器背书））。
model MaintenanceActivityRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  seq           BigInt    @default(autoincrement()) @db.BigInt
  kind          String
  resourceRef   String    @map("resource_ref")
  planId        String?   @map("plan_id")
  planVersion   Int?      @map("plan_version")
  taskId        String?   @map("task_id")
  checkpointId  String?   @map("checkpoint_id")
  result        String?
  actionsDone   Json?     @map("actions_done")
  faultRef      String?   @map("fault_ref")
  restored      Boolean?
  performedBy   String    @map("performed_by")
  performedAt   DateTime  @db.Timestamptz(6) @map("performed_at")
  note          String?
  occurredAt    DateTime  @db.Timestamptz(6) @map("occurred_at")
  recordedBy    String    @map("recorded_by")
  objectVersion Int       @default(1) @map("object_version")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  supersedes    String?   @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")

  @@index([tenantId, resourceRef, performedAt(sort: Desc), seq(sort: Desc)])
  @@index([tenantId, taskId])
  @@map("maintenance_activities")
}

/// 命令幂等记账行（MaintenanceOperationStore 端口的 PG 持久化；运营表，形态同
/// payroll_operations / drawing_operations）。
model MaintenanceOperationRecord {
  id          String   @id @default(uuid(7))
  tenantId    String   @map("tenant_id")
  operationId String   @map("operation_id")
  commandKind String   @map("command_kind")

  @@unique([tenantId, operationId])
  @@map("maintenance_operations")
}

