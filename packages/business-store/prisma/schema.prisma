// ============================================================================
// drawing 模块（M3，m3-drafts/03-drawing.md v1.0）——图纸域：版本化修订链
// append-only + 发布联动通知事实 + 查看留痕审计事实 + 幂等记账运营表。
// 域事件不建新表（落既有 event_records / outbox_records，见 pg-drawing-stores）。
// ============================================================================

/// 图纸修订行（DrawingRevisionStore 端口的 PG 持久化；版本化文档 append-only
/// 链：(tenant, drawing_id, version) 与 (tenant, supersedes) 唯一；version=
/// 链尾+1（服务层推导，客户端不传）；drawing_id = 图号 opaque 锚（编码规则=
/// 数据约定）；classification = 保密等级数据值（两级值集默认配置，R-M3-6）；
/// supersedes = 前任**行 id**（证据列口径）；supersedes_version = version−1
/// 由链连续性派生（映射器计算，不落列）；file_ref = 内容指针——查看必过门禁
/// 必留痕（服务层不变量，本表不做行级过滤）。
model DrawingRevisionRecord {
  id             String    @id @default(uuid(7))
  tenantId       String    @map("tenant_id")
  drawingId      String    @map("drawing_id")
  version        Int
  fileRef        String    @map("file_ref")
  changeNote     String    @map("change_note")
  classification String
  changedBy      String    @map("changed_by")
  changedAt      DateTime  @db.Timestamptz(6) @map("changed_at")
  objectVersion  Int       @default(1) @map("object_version")
  supersedes     String?   @map("supersedes")
  auditStatus    String    @map("audit_status")
  provenance     Json?     @map("provenance")
  businessTime   DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime  DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt      DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, drawingId, version])
  @@unique([tenantId, supersedes])
  @@index([tenantId, drawingId])
  @@map("drawing_revisions")
}

/// 变更通知行（DrawingChangeNoticePort 的 PG 持久化；发布联动事实：from→to+
/// changeNote+发布时点，首发 from=0；(tenant, drawing_id, to_version) 唯一 =
/// 联动幂等锚点；消费方轮询/对账走 sinceVersion 游标——"我引用的 v3 是否已有
/// 更新"；终端 append-only 事实，supersedes 恒空）。
model DrawingChangeNoticeRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  drawingId     String    @map("drawing_id")
  fromVersion   Int       @map("from_version")
  toVersion     Int       @map("to_version")
  changeNote    String    @map("change_note")
  publishedAt   DateTime  @db.Timestamptz(6) @map("published_at")
  objectVersion Int       @default(1) @map("object_version")
  supersedes    String?   @map("supersedes")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, drawingId, toVersion])
  @@index([tenantId, drawingId])
  @@map("drawing_change_notices")
}

/// 查看留痕行（DrawingViewTrailStore 端口的 PG 持久化；append-only 审计事实：
/// 每次查看一行——谁/何时/哪修订/当时保密等级快照，seq bigserial 游标；
/// 保密审计最低门槛（合同 §2 两不变量之"必留痕"）；终端事实无业务唯一键、
/// supersedes 恒空）。
model DrawingViewTrailRecord {
  id             String    @id @default(uuid(7))
  tenantId       String    @map("tenant_id")
  seq            BigInt    @default(autoincrement()) @db.BigInt
  drawingId      String    @map("drawing_id")
  version        Int
  viewedBy       String    @map("viewed_by")
  viewedAt       DateTime  @db.Timestamptz(6) @map("viewed_at")
  classification String
  objectVersion  Int       @default(1) @map("object_version")
  supersedes     String?   @map("supersedes")
  auditStatus    String    @map("audit_status")
  provenance     Json?     @map("provenance")
  businessTime   DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime  DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt      DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, drawingId])
  @@index([tenantId, viewedBy])
  @@map("drawing_view_trails")
}

/// 命令幂等记账行（DrawingOperationStore 端口的 PG 持久化；运营表，形态同
/// payroll_operations / metric_pack_operations）。
model DrawingOperationRecord {
  id          String   @id @default(uuid(7))
  tenantId    String   @map("tenant_id")
  operationId String   @map("operation_id")
  commandKind String   @map("command_kind")

  @@unique([tenantId, operationId])
  @@map("drawing_operations")
}

// ============================================================================
// maintenance 模块（M3，m3-drafts/02-maintenance.md v1.0）——维保执行域：计划
// 版本化主数据 + 任务状态机投影行 + 三态记录 append-only 事实 + 幂等记账运营表。
// 域事件不建新表（落既有 event_records / outbox_records，见 pg-maintenance-stores）。
// ============================================================================

/// 维保计划版本行（MaintenancePlanStore 端口的 PG 持久化；版本化主数据——形态同
/// payroll_rules：(tenant, plan_id, object_version) 与 (tenant, supersedes) 唯一；
/// plan_id = kebab 业务身份跨版本稳定；cycle JSONB = daily / interval-days；
/// checkpoints JSONB = 点检判据清单（判据是数据不是枚举）；upkeep_actions JSONB =
/// 保养动作清单——修订=发新版本，历史记录溯源旧版可解释）。
model MaintenancePlanRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  planId        String    @map("plan_id")
  name          String?
  resourceRef   String    @map("resource_ref")
  cycle         Json
  checkpoints   Json
  upkeepActions Json      @map("upkeep_actions")
  objectVersion Int       @default(1) @map("object_version")
  supersedes    String?   @map("supersedes")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, planId, objectVersion])
  @@unique([tenantId, supersedes])
  @@index([tenantId, planId])
  @@index([tenantId, resourceRef])
  @@map("maintenance_plans")
}

/// 维保任务投影行（MaintenanceTaskStore 端口的 PG 持久化；状态机投影——形态同
/// fault_reports / inspections：state + object_version 随迁移条件更新（非事实表
/// 不套证据公共列）；flow_config_id = engine-flow 配置换代防线；(tenant,
/// source_key) 唯一 = plan-due 任务到期锚点 due:<planId>:<occurrenceKey>
/// （due-scan 幂等去重 DB 防线；manual/fault 任务 source_key 空，PG 默认
/// NULLS DISTINCT 不参与唯一约束）；G2：建单先落 scheduled@v1 投影）。
model MaintenanceTaskRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  flowConfigId  String    @map("flow_config_id")
  source        String
  kind          String
  resourceRef   String    @map("resource_ref")
  faultRef      String?   @map("fault_ref")
  planId        String?   @map("plan_id")
  planVersion   Int?      @map("plan_version")
  dueKey        String?   @map("due_key")
  dueAt         DateTime? @db.Timestamptz(6) @map("due_at")
  assignee      String?
  state         String
  objectVersion Int       @default(1) @map("object_version")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  startedAt     DateTime? @db.Timestamptz(6) @map("started_at")
  completedAt   DateTime? @db.Timestamptz(6) @map("completed_at")
  cancelledAt   DateTime? @db.Timestamptz(6) @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason")
  sourceKey     String?   @map("source_key")

  @@unique([tenantId, sourceKey])
  @@index([tenantId, state])
  @@index([tenantId, resourceRef])
  @@index([tenantId, assignee])
  @@index([tenantId, planId])
  @@map("maintenance_tasks")
}

/// 三态记录行（MaintenanceActivityStore 端口的 PG 持久化；append-only 执行留痕
/// 事实，kind 判别三态 checkpoint/upkeep/repair（草案形状保持）：checkpoint 落
/// checkpoint_id+result；upkeep 落 actions_done JSONB；repair 落 fault_ref+
/// restored；证据七公共列 TEXT 口径 + seq 游标；plan_version 快照 = 记录时点
/// 计划当前版本（溯源旧版可解释）；修正走冲销/补录不改原行（触发器背书））。
model MaintenanceActivityRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  seq           BigInt    @default(autoincrement()) @db.BigInt
  kind          String
  resourceRef   String    @map("resource_ref")
  planId        String?   @map("plan_id")
  planVersion   Int?      @map("plan_version")
  taskId        String?   @map("task_id")
  checkpointId  String?   @map("checkpoint_id")
  result        String?
  actionsDone   Json?     @map("actions_done")
  faultRef      String?   @map("fault_ref")
  restored      Boolean?
  performedBy   String    @map("performed_by")
  performedAt   DateTime  @db.Timestamptz(6) @map("performed_at")
  note          String?
  occurredAt    DateTime  @db.Timestamptz(6) @map("occurred_at")
  recordedBy    String    @map("recorded_by")
  objectVersion Int       @default(1) @map("object_version")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  supersedes    String?   @map("supersedes")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")

  @@index([tenantId, resourceRef, performedAt(sort: Desc), seq(sort: Desc)])
  @@index([tenantId, taskId])
  @@map("maintenance_activities")
}

/// 命令幂等记账行（MaintenanceOperationStore 端口的 PG 持久化；运营表，形态同
/// payroll_operations / drawing_operations）。
model MaintenanceOperationRecord {
  id          String   @id @default(uuid(7))
  tenantId    String   @map("tenant_id")
  operationId String   @map("operation_id")
  commandKind String   @map("command_kind")

  @@unique([tenantId, operationId])
  @@map("maintenance_operations")
}
