  workOrderId   String?  @map("work_order_id")
  flowConfigId  String   @map("flow_config_id")
  state         String
  objectVersion Int      @default(2) @map("object_version")
  supplierRef   String?  @map("supplier_ref")
  supplierName  String?  @map("supplier_name")
  promisedAt    DateTime @db.Timestamptz(6) @map("promised_at")
