// drawing 模块（M3，m3-drafts/03-drawing.md v1.0）——图纸域：版本化修订链
// append-only + 发布联动通知事实 + 查看留痕审计事实 + 幂等记账运营表。
// 域事件不建新表（落既有 event_records / outbox_records，见 pg-drawing-stores）。
// ============================================================================

/// 图纸修订行（DrawingRevisionStore 端口的 PG 持久化；版本化文档 append-only
/// 链：(tenant, drawing_id, version) 与 (tenant, supersedes) 唯一；version=
/// 链尾+1（服务层推导，客户端不传）；drawing_id = 图号 opaque 锚（编码规则=
/// 数据约定）；classification = 保密等级数据值（两级值集默认配置，R-M3-6）；
/// supersedes = 前任**行 id**（证据列口径）；supersedes_version = version−1
/// 由链连续性派生（映射器计算，不落列）；file_ref = 内容指针——查看必过门禁
/// 必留痕（服务层不变量，本表不做行级过滤）。
model DrawingRevisionRecord {
  id             String    @id @default(uuid(7))
  tenantId       String    @map("tenant_id")
  drawingId      String    @map("drawing_id")
  version        Int
  fileRef        String    @map("file_ref")
  changeNote     String    @map("change_note")
  classification String
  changedBy      String    @map("changed_by")
  changedAt      DateTime  @db.Timestamptz(6) @map("changed_at")
  objectVersion  Int       @default(1) @map("object_version")
  supersedes     String?   @map("supersedes")
  auditStatus    String    @map("audit_status")
  provenance     Json?     @map("provenance")
  businessTime   DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime  DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt      DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, drawingId, version])
  @@unique([tenantId, supersedes])
  @@index([tenantId, drawingId])
  @@map("drawing_revisions")
}

/// 变更通知行（DrawingChangeNoticePort 的 PG 持久化；发布联动事实：from→to+
/// changeNote+发布时点，首发 from=0；(tenant, drawing_id, to_version) 唯一 =
/// 联动幂等锚点；消费方轮询/对账走 sinceVersion 游标——"我引用的 v3 是否已有
/// 更新"；终端 append-only 事实，supersedes 恒空）。
model DrawingChangeNoticeRecord {
  id            String    @id @default(uuid(7))
  tenantId      String    @map("tenant_id")
  drawingId     String    @map("drawing_id")
  fromVersion   Int       @map("from_version")
  toVersion     Int       @map("to_version")
  changeNote    String    @map("change_note")
  publishedAt   DateTime  @db.Timestamptz(6) @map("published_at")
  objectVersion Int       @default(1) @map("object_version")
  supersedes    String?   @map("supersedes")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, drawingId, toVersion])
  @@index([tenantId, drawingId])
  @@map("drawing_change_notices")
}

/// 查看留痕行（DrawingViewTrailStore 端口的 PG 持久化；append-only 审计事实：
/// 每次查看一行——谁/何时/哪修订/当时保密等级快照，seq bigserial 游标；
/// 保密审计最低门槛（合同 §2 两不变量之"必留痕"）；终端事实无业务唯一键、
