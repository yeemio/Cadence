  modelCode     String    @map("model_code")
  modelVersion  Int       @map("model_version")
  totals        Json
  rebuiltBy     String    @map("rebuilt_by")
  rebuiltAt     DateTime  @db.Timestamptz(6) @map("rebuilt_at")
  objectVersion Int       @default(1) @map("object_version")
  supersedes    String?   @map("supersedes")
  auditStatus   String    @map("audit_status")
  provenance    Json?     @map("provenance")
  businessTime  DateTime? @db.Timestamptz(6) @map("business_time")
  availableTime DateTime? @db.Timestamptz(6) @map("available_time")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, workOrderId, modelCode, modelVersion, objectVersion])
  @@unique([tenantId, supersedes])
  @@index([tenantId, workOrderId])
  @@map("cost_snapshots")
}

