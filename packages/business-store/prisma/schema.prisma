// ---------------------------------------------------------------------------
// U1 issue 发料链路（U 波 A11 增量：发料任务/发料记录）。五表分工（体例照抄
// inventory/listing 节取舍，DDL 见 migrations/20261026140000_issue_module）：
//   issue_tasks / issue_task_lines    投影（任务状态由汇总推导 refreshSummary
//                                     乐观推进；子行按 (task, source_line_id)
//                                     去重补全——派工同步幂等锚点）；
//   issue_records                     投影（确认快照 + 撤销态：lines 为 JSONB
//                                     载荷含库位分配与扣减回执快照，同
//                                     purchase_orders.lines 取舍；撤销 = state
//                                     迁移 revoked，legacy is_deleted 语义）；
//   issue_expresses                   投影（配件发料发货头元数据；对象存储零
//                                     依赖——图片只存引用串数组）；
//   issue_operations                  命令幂等记账（PK = operation_key =
//                                     租户|operationId，运营表豁免触发器）。
// 均不套证据公共列、不设 append-only 触发器（运营单据非不可变事实——不可变
// 事实由域事件 event_records/outbox_records 承载，复用 M1 既有表）。
// 维度唯一性：issue_tasks (tenant, dimension_key) 唯一——dimension_key 为应用
// 侧拼键（工作令|派工类型|归拢|设备引用），归拢行设备维空值也收敛进唯一键
// （PG unique 对 NULL 不去重，拼键规避）。
// ---------------------------------------------------------------------------

/// 发料任务主行（投影；状态 not-started/issuing/done 由汇总推导）。
model IssueTaskRecord {
  id              String    @id @default(uuid(7))
  tenantId        String    @map("tenant_id")
  taskNo          String    @map("task_no")
  workOrderId     String    @map("work_order_id")
  workOrderLabel  String?   @map("work_order_label")
  /// assembly / electrical。
  dispatchKind    String    @map("dispatch_kind")
  /// 整线装配外购设备归拢（一工作令一条，equipment_ref 为空）。
  rollup          Boolean   @default(false)
  /// 工作令设备维（opaque；归拢任务为空）。
  equipmentRef    String?   @map("equipment_ref")
  /// 维度拼键（工作令|派工类型|归拢|设备引用——应用侧拼键；归拢行设备维空值
  /// 收敛进唯一键，规避 PG unique 对 NULL 不去重）。
  dimensionKey    String    @map("dimension_key")
  state           String
  objectVersion   Int       @default(1) @map("object_version")
  plannedStartAt  DateTime? @db.Timestamptz(6) @map("planned_start_at")
  plannedEndAt    DateTime? @db.Timestamptz(6) @map("planned_end_at")
  /// 操作工人快照（JSONB 数组）。
  operators       Json      @default("[]")
  /// 触发来源锚点集（JSONB 数组：关联派工单展示用）。
  triggerRefs     Json      @default("[]") @map("trigger_refs")
  totalRequiredQty Float    @default(0) @map("total_required_qty")
  totalIssuedQty  Float     @default(0) @map("total_issued_qty")
  finishedAt      DateTime? @db.Timestamptz(6) @map("finished_at")
  createdAt       DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, dimensionKey])
  @@index([tenantId, state])
  @@index([tenantId, workOrderId])
  @@map("issue_tasks")
}

/// 发料任务明细行（投影；(tenant, task, source_line_id) 唯一 = 派工同步补全幂等锚点）。
model IssueTaskLineRecord {
  id           String   @id @default(uuid(7))
  tenantId     String   @map("tenant_id")
  taskId       String   @map("task_id")
  lineNo       Int      @map("line_no")
  /// part / standard / electrical / equipment（镜像 listing 四类清单 kind）。
  kind         String
  sourceLineId String   @map("source_line_id")
  itemId       String?  @map("item_id")
  moduleName   String?  @map("module_name")
  name         String?
  drawingNo    String?  @map("drawing_no")
  requiredQty  Float    @map("required_qty")
  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, taskId, sourceLineId])
  @@index([tenantId, taskId])
  @@index([tenantId, sourceLineId])
  @@map("issue_task_lines")
}

/// 发料记录主行（投影：确认快照 + 撤销态；lines 为 JSONB 明细快照集）。
model IssueRecordRecord {
  id             String    @id @default(uuid(7))
  tenantId       String    @map("tenant_id")
  recordNo       String    @map("record_no")
  taskId         String    @map("task_id")
  taskNo         String    @map("task_no")
  workOrderId    String    @map("work_order_id")
  workOrderLabel String?   @map("work_order_label")
  dispatchKind   String    @map("dispatch_kind")
  rollup         Boolean   @default(false)
  equipmentRef   String?   @map("equipment_ref")
  /// 本次发料类别（一条记录一种类别）。
  lineKind       String    @map("line_kind")
  issuedAt       DateTime  @db.Timestamptz(6) @map("issued_at")
  issuedBy       String    @map("issued_by")
  totalQty       Float     @map("total_qty")
  expressId      String?   @map("express_id")
  /// active / revoked（revoked 不计入已发累计）。
  state          String    @default("active")
  revokedAt      DateTime? @db.Timestamptz(6) @map("revoked_at")
  revokedBy      String?   @map("revoked_by")
  /// 明细快照集（JSONB：行快照 + 库位分配 + 扣减回执 + issueKey 回滚锚点）。
  lines          Json
  objectVersion  Int       @default(1) @map("object_version")
  createdAt      DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, taskId])
  @@index([tenantId, workOrderId])
  @@index([tenantId, issuedAt(sort: Desc)])
  @@map("issue_records")
}

/// 快递单（发货头元数据投影；图片引用串数组 ≤6，对象存储零依赖）。
model IssueExpressRecord {
  id          String   @id @default(uuid(7))
  tenantId    String   @map("tenant_id")
  trackingNo  String   @map("tracking_no")
  shipper     String
  shipTime    DateTime @db.Timestamptz(6) @map("ship_time")
  imageRefs   Json     @default("[]") @map("image_refs")
  workOrderId String?  @map("work_order_id")
  taskId      String?  @map("task_id")
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, workOrderId, trackingNo])
  @@index([tenantId, taskId])
  @@map("issue_expresses")
}

/// 命令幂等记账行（IssueOperationStore 端口的 PG 持久化；运营表豁免触发器）。
model IssueOperationRecord {
  operationKey  String   @id @map("operation_key")
  tenantId      String   @map("tenant_id")
  operationId   String   @map("operation_id")
  command       String
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  occurredAt    DateTime @db.Timestamptz(6) @map("occurred_at")

  @@index([tenantId])
  @@map("issue_operations")
}

// ---------------------------------------------------------------------------
// U3 attachment 附件中心（U 波 A13：统一附件元数据 + ObjectStoragePort）。
// 单表 attachments = 文档 mes_biz_file 重述（体例照抄 notifications 节取舍）：
// 轻量运营元数据（追加 + 逻辑删除 deleted_at 置位），不套证据公共列、不设
// append-only 触发器。存储引用三字段（storage_kind/target/object_key）为
// ObjectStoragePort 对象引用（文档方案 B），仅签发短时只读引用时读——列表
// VO 不下发（文档已确认决策：减少暴露）。物理字节在端口适配器侧（内存/
// 本地文件，MinIO/S3 接入归部署期换装），本表零对象存储依赖。
// 词汇重述（ADR-0010）：biz_module 字典 → biz_type 通用类型码（单段小写，
// 取值由消费方定义）；storage_type 字典 → storage_kind 适配器自述串；
// bucket_name → target；is_deleted → deleted_at；status 框架占位不落。
// 排序合同：createdAt DESC + id ASC（列表索引前导租户）。
// ---------------------------------------------------------------------------

/// 附件元数据行（AttachmentStore 端口的 PG 持久化；逻辑删除不删物理对象）。
model AttachmentRecord {
  id          String    @id @default(uuid(7))
  tenantId    String    @map("tenant_id")
  fileName    String    @map("file_name")
  contentType String?   @map("content_type")
  /// 端口适配器自述存储类型（'memory' / 'local-fs' / 未来 'minio' 等）。
  storageKind String    @map("storage_kind")
  /// 存储目标标识（桶名 / 本地根目录名；保存时服务端按端口当前目标写入）。
  target      String
  /// 目标内对象键（不含目标名、不含前导 /）。
  objectKey   String    @map("object_key")
  /// 展示/兼容地址（可空——下载不以它为准，以端口签发的短时只读引用为准）。
  fileUrl     String?   @map("file_url")
  bizType     String    @map("biz_type")
  bizId       String    @map("biz_id")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  /// 逻辑删除时刻（null = 有效；删除不删物理对象）。
  deletedAt   DateTime? @db.Timestamptz(6) @map("deleted_at")

  @@index([tenantId, bizId, createdAt(sort: Desc)])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// fix-wave-4 W4-2（D-3）：附件对象字节表（ObjectStoragePort 的 PG 适配器侧）。
// attachments 元数据表零变更；字节走独立新表——列表/详情查询永不触碰字节列
// （bytea 自动 TOAST，仅 select 时解外，隔离于元数据热路径）。32MiB 护栏在
// 适配器层把门（与 attachment-input MAX_UPLOAD_BYTES 同值，纵深防御）；
// 租户收口 = tenant_id 行级（RLS 同批补登：src/rls/tables.ts + 重放迁移
// 20261026180100）。object_key 库内唯一（uuid 体例，put 恒新生成）——
// bytea 形态下键退化为库内唯一标识，租户隔离由 tenant_id 行承载（预研
// §3.1：MinIO/S3 前缀欠账不被本形态触发）。
// ---------------------------------------------------------------------------

/// 附件对象字节行（PgObjectStorage 端口的持久化；put 追加，无更新/删除面）。
model AttachmentObjectRecord {
  id        String   @id @default(uuid(7))
  tenantId  String   @map("tenant_id")
  /// 库内唯一对象键（upload/yyyy/mm/dd/<uuid>-<slug> 体例，适配器生成）。
  objectKey String   @unique @map("object_key")
  /// 对象字节（PG bytea；TOAST 行外存储，32MiB 护栏内）。
  bytes     Bytes
  contentType String? @map("content_type")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, objectKey])
  @@map("attachment_objects")
}

// ---------------------------------------------------------------------------
// A8/A10 首波（PRD 20 册 RREQ-RP-023~027）：每日机加工进度统计日表。
// 报表域自持统计快照（PRD §6 写入面边界：本域对业务域只读，仅口径装载
// 记录与统计快照表自持）。运营快照形态（存在则更新否则插入——不套证据
// 公共列，取舍同 cost_price_entries / attachments 运营投影先例）；
// (tenant_id, statistics_date) 唯一 = 一行一天。两指标列 nullable：清单行
// 加工类型/入库状态 + 工序机加/表处分类三读面缺失（登记不做，公式冻结见
// application machining-daily-stores.ts 头注），读面落地后本表结构不变。
// pending_reasons JSONB = 指标级占位说明（两指标可读时为空对象）。
// RLS 同批补登：src/rls/tables.ts + 全量重放迁移 20261026190100。
// ---------------------------------------------------------------------------

/// 每日机加工进度统计行（MachiningDailyStatsStore 端口的 PG 持久化；纯跑批写入）。
model MachiningDailyStatRecord {
  id                          String   @id @default(uuid(7))
  tenantId                    String   @map("tenant_id")
  /// 统计日 yyyy-MM-dd（OQ-6 缺省 = 跑批前一日）。
  statisticsDate              String   @map("statistics_date")
  /// 表处中图号数（读面缺失时 null）。
  surfaceTreatmentDrawingCount Int?    @map("surface_treatment_drawing_count")
  /// 待机加数量（残差公式，允许为负；读面缺失时 null）。
  pendingMachiningCount       Int?     @map("pending_machining_count")
  /// 指标级占位说明（metric → 原因；JSONB）。
  pendingReasons              Json     @map("pending_reasons")
  /// 本次跑批时刻（审计排查）。
  computedAt                  DateTime @db.Timestamptz(6) @map("computed_at")
  /// 跑批主体（系统任务标识）。
  computedBy                  String   @map("computed_by")
  createdAt                   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, statisticsDate])
  @@map("machining_daily_stats")
}

// ---------------------------------------------------------------------------
// fix-wave-6 6b-3（A14 / PRD 22 册 RREQ-INT-032）：用户表格列显隐偏好表。
// 三元组（user_id × page_key × table_key）一条有效记录，只存隐藏列 prop
// 集合（JSONB 数组；空数组 = 用户显式全显示，与"从未保存"由行缺位区分）。
// 偏好数据非业务事实——不套证据公共列（取舍同 menu_configs / attachments
// 运营投影先例）；无 delete（清空 = upsert 空数组）。
// 与源文档差异（登记）：源《用户表格列显隐配置》§1.3"库上不建 UNIQUE、由
// Service 先查再插/更"——并发下会双行；我方收口为库级 UNIQUE 支撑幂等
// upsert（tenant 前导，兼作 RLS 索引前导断言面）。RLS 同批补登：
// src/rls/tables.ts + 全量重放迁移 20261026200100。
// ---------------------------------------------------------------------------

/// 用户表格列显隐偏好行（ColumnPreferenceStore 端口的 PG 持久化）。
model ColumnPreferenceRecord {
  id          String   @id @default(uuid(7))
  tenantId    String   @map("tenant_id")
  /// 偏好归属用户（服务端取会话身份写入；请求体 userId 一律忽略）。
  userId      String   @map("user_id")
  /// 页面标识（一般 = 前端路由 path；≤128）。
  pageKey     String   @map("page_key")
  /// 表格标识（一页多表用不同 key；≤128）。
  tableKey    String   @map("table_key")
  /// 隐藏列 prop 集合（JSONB 数组，去空/去重/保序；[] = 显式全显示）。
  hiddenProps Json      @map("hidden_props")
  /// 上次保存时刻（upsert 推进）。
  updatedAt   DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, userId, pageKey, tableKey])
  @@map("column_preferences")
}

/// 工作令产品设备清单；旧行不回填、不把车间设备资产当产品设备。
model WorkOrderEquipmentRecord {
  id String @id
  tenantId String @map("tenant_id")
  workOrderId String @map("work_order_id")
  code String
  name String
  quantity Int
  kind String
  @@unique([tenantId, workOrderId, code])
  @@unique([tenantId, workOrderId, name])
  @@unique([tenantId, workOrderId, id])
  @@map("work_order_equipment")
}

