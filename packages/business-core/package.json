{
  "name": "@smes/business-core",
  "version": "0.1.0",
  "private": true,
  "description": "纯领域层：品牌化 ID、CommandEnvelope（smes.command.v1）、业务事件基类、证据标准。无框架、无存储、无 IO。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --reporter=dot"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
