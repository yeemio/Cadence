# deploy/.env.example —— 复制为 deploy/.env（compose 以 compose.yaml 所在目录
# 为 project 目录并读取其中 .env）。单机形态可全部留缺省，直接 up。
#
# ---- 单机（买断私有化，缺省形态） ----
COMPOSE_PROJECT_NAME=cadence
POSTGRES_PASSWORD=change-me-single-node-owner
POSTGRES_APP_PASSWORD=change-me-app-user
SMES_TENANT_MODE=single-node
SMES_DOMAIN=
PG_PORT=55432
SERVER_PORT=3000
WEB_PORT=8080
PROXY_PORT=80

# ---- SaaS（订阅托管）启用段：注释互换 + --profile saas ----
# SMES_TENANT_MODE=saas
# SMES_DOMAIN=smes.example.com
# 已知租户逗号清单（saas 必填：未知子域 fail-closed；租户管理流程属 M4 后续波）
# SMES_TENANTS=acme,beatrix

# ---- M2 安全批 SP-3：附件/图纸两域签名密钥（多实例/跨重启部署必须设置）----
# 值 = base64 或 hex 编码、解码后恰 32 字节（直接作 HMAC-SHA256 key）。
# 生成示例：openssl rand -hex 32（64 位 hex）或 openssl rand -base64 32（44 位 base64）。
# 未设/留空 = 实例内随机——重启后既有附件下载引用/图纸只读引用失效（单机演示
# 可用）；格式非法 = server 拒绝启动（fail-fast）。两域各用独立值，勿复用同一密钥。
SMES_ATTACHMENT_REF_SECRET=
SMES_DRAWING_REF_SECRET=
